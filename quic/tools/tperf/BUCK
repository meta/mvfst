# The knobs patcher only exists for fbcode Linux builds. `fbcode//justknobs`
# is not an xplat project, so this target bypasses the fbcode -> fbsource dep
# conversion (which would drop it) and spells its deps out as fbsource targets.
_FBCODE_LINUX = "ovr_config//runtime:fbcode"

# Declared directly so the fbcode-only deps survive: the `mvfst_cpp_*` macros
# convert fbcode deps to xplat ones and drop the ones they cannot map.
fb_xplat_cxx_library(
    name = "tperf_knobs_patcher",
    srcs = select({
        "DEFAULT": ["TperfKnobsPatcherXPlat.cpp"],
        _FBCODE_LINUX: select({
            "DEFAULT": ["TperfKnobsPatcherXPlat.cpp"],
            "ovr_config//os/constraints:linux": ["TperfKnobsPatcherFbcode.cpp"],
        }),
    }),
    header_namespace = "quic/tools/tperf",
    exported_headers = ["TperfKnobsPatcher.h"],
    compiler_flags = CXXFLAGS,
    feature = Infra_Networking_Core,
    platforms = (CXX, ANDROID, APPLE, FBCODE, WINDOWS),
    visibility = ["PUBLIC"],
    deps = ["fbsource//xplat/quic/common:mvfst_logging"]
    + (
        select({
            "DEFAULT": [],
            _FBCODE_LINUX: select({
                "DEFAULT": [],
                "ovr_config//os/constraints:linux": [
                    "fbcode//justknobs:justknobs_patches",
                    "fbsource//xplat/folly:string",
                ],
            }),
        })
        if is_fbcode_compatible()
        else []
    ),
)

_TPERF_DEPS = [
    ":tperf_client",
    ":tperf_knobs_patcher",
    ":tperf_server",
    ":tperf_tcp",
    "fbsource//xplat/folly/init:init",
    "fbsource//xplat/folly/portability:gflags",
    "fbsource//xplat/folly:string",
    "//quic/common:mvfst_logging",
] + select({
    "DEFAULT": ["fbsource//xplat/folly:memcpy-use"],
    "ovr_config//os:windows": [],
})

mvfst_cpp_binary(
    name = "tperf",
    srcs = [
        "tperf.cpp",
    ],
    deps = _TPERF_DEPS,
)

# Same tperf binary, built with the xsec_crypto AEAD backend instead of
# fizz/OpenSSL, matching prod revproxy (encrypt via xsec, decrypt via OpenSSL).
# The constraints are applied as cfg modifiers (like revproxy's proxygend) so
# they compose with the selected platform/build mode rather than pinning one.
# use_alt_crypto -> QUIC_DEFAULT_AEAD = XSecCryptoAead; force_alt_crypto -> the
# bridge always uses xsec (bypasses the JK). No flag; :tperf is the OpenSSL
# baseline. fbcode only: the xsec sources live in fbcode/quic/facebook.
mvfst_cpp_binary(
    name = "tperf-xsec",
    srcs = [
        "tperf.cpp",
    ],
    modifiers = [
        "fbcode//quic:use_alt_crypto-enabled",
        "fbcode//quic:force_alt_crypto-enabled",
    ],
    platforms = (FBCODE,),
    deps = _TPERF_DEPS
    + [
        "//xsec_crypto/cpp20/haberdashery/aead/extensions:aes128gcm_zen4_extension",
    ],
)

mvfst_cpp_binary(
    name = "tperf-xsec-zen4",
    srcs = [
        "tperf.cpp",
    ],
    modifiers = [
        "fbcode//quic:use_alt_crypto-enabled",
        "fbcode//quic:force_alt_crypto-enabled",
    ],
    platforms = (FBCODE,),
    deps = _TPERF_DEPS
    + [
        "//xsec_crypto/cpp20/haberdashery/aead/extensions:aes128gcm_zen4_benchmark_extension",
    ],
)

